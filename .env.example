# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flipkart_wishlist?schema=public"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google Sign-In
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Wishlist sync interval (ms) — defaults to 30000 (30s) if unset
NEXT_PUBLIC_WISHLIST_SYNC_INTERVAL_MS="30000"
